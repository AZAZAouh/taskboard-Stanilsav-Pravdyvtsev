  "item": [
    {
      "name": "T-01 — Rejestracja nowego użytkownika",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{registrationLogin}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Uruchamiaj całą kolekcję w Collection Runner po kolei, z włączonymi ciasteczkami. Rejestracja tworzy osobne konto viewer. Operacje edytora używają wyłącznie tablicy i zadania utworzonych w tym uruchomieniu. Konto testowe zostaje w bazie, zadanie i tablica są usuwane miękko na końcu."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['boardId','taskId'].forEach(key => pm.collectionVariables.unset(key));",
              "pm.collectionVariables.set('registrationLogin', 'pm_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 24));",
              "pm.collectionVariables.set('registrationPassword', 'Pm_' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Bez hasha hasła\", () => pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
            ]
          }
        }
      ]
    },
