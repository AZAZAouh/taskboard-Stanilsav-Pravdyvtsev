{
  "info": {
    "name": "TaskBoard — auth, tablice i zadania",
    "description": "25 zapytań: T-01–T-20 z docs/testy.md i 5 kroków pomocniczych dotyczących logowania oraz tablic. Uruchamiaj całą kolekcję po kolei. Postman przechowuje ciasteczko sesji. editorLogin musi mieć rolę editor lub admin; domyślnie anna.nowak. missingId musi wskazywać nieistniejący rekord. Tworzone są własne dane testowe; nie używamy istniejących tablic. Konto viewer i miękko usunięte rekordy pozostają po teście. Nie eksportuj prywatnych haseł.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "editorLogin",
      "value": "anna.nowak"
    },
    {
      "key": "editorPassword",
      "value": "Test1234!"
    },
    {
      "key": "missingId",
      "value": "4294967295"
    }
